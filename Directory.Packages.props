<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- every project (Directory.Build.props) -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>

  <!-- the logger -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="15.8.0" />
  </ItemGroup>

  <!-- the example tests -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="3.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Nullean.Xunit.Partitions" Version="0.5.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- under CPM the F# SDK adds no implicit FSharp.Core: this is the version the build resolved before -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Argu" Version="6.0.0" />
    <PackageVersion Include="Bullseye" Version="6.0.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="5.15.0" />
    <PackageVersion Include="Proc" Version="0.9.1" />
  </ItemGroup>
</Project>
