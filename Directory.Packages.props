<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- every project (Directory.Build.props) -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

  <!-- the logger -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="18.11.0" />
  </ItemGroup>

  <!-- the example tests -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Nullean.Xunit.Partitions" Version="0.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- under CPM the F# SDK adds no implicit FSharp.Core: this is the version the build resolved before -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <PackageVersion Include="Argu" Version="6.2.5" />
    <PackageVersion Include="Bullseye" Version="6.3.0" />
    <PackageVersion Include="Fake.Tools.Git" Version="6.2.0" />
    <PackageVersion Include="Proc" Version="0.14.0" />
  </ItemGroup>
</Project>
